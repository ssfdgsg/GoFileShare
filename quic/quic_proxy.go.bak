package quic

import (
	"context"
	"crypto/rand"
	"crypto/rsa"
	"crypto/tls"
	"crypto/x509"
	"crypto/x509/pkix"
	"encoding/pem"
	"fmt"
	"io"
	"log"
	"math/big"
	"net"
	"net/http"
	"sync"
	"time"

	"github.com/quic-go/quic-go"
	"github.com/quic-go/quic-go/http3"
)

// QUICProxy QUIC代理结构
type QUICProxy struct {
	localAddr   string
	remoteAddr  string
	listener    *quic.Listener
	client      quic.Connection
	tlsConfig   *tls.Config
	httpClient  *http.Client
	isServer    bool
	connections map[string]quic.Connection
	mutex       sync.RWMutex
	isRunning   bool
}

// NewQUICProxy 创建新的QUIC代理
func NewQUICProxy(localAddr string, isServer bool) (*QUICProxy, error) {
	tlsConfig, err := generateTLSConfig()
	if err != nil {
		return nil, fmt.Errorf("生成TLS配置失败: %w", err)
	}

	proxy := &QUICProxy{
		localAddr:   localAddr,
		tlsConfig:   tlsConfig,
		isServer:    isServer,
		connections: make(map[string]quic.Connection),
		isRunning:   true,
	}

	// 创建HTTP3客户端
	roundTripper := &http3.RoundTripper{
		TLSClientConfig: &tls.Config{
			InsecureSkipVerify: true,
		},
	}
	proxy.httpClient = &http.Client{
		Transport: roundTripper,
	}

	return proxy, nil
}

// generateTLSConfig 生成TLS配置
func generateTLSConfig() (*tls.Config, error) {
	key, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		return nil, err
	}

	template := x509.Certificate{
		SerialNumber: big.NewInt(1),
		Subject: pkix.Name{
			Organization:  []string{"GoFileShare"},
			Country:       []string{"CN"},
			Province:      []string{""},
			Locality:      []string{""},
			StreetAddress: []string{""},
			PostalCode:    []string{""},
		},
		NotBefore:   time.Now(),
		NotAfter:    time.Now().Add(365 * 24 * time.Hour),
		KeyUsage:    x509.KeyUsageKeyEncipherment | x509.KeyUsageDigitalSignature,
		ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
		IPAddresses: []net.IP{net.IPv4(127, 0, 0, 1), net.IPv6loopback},
		DNSNames:    []string{"localhost"},
	}

	certDER, err := x509.CreateCertificate(rand.Reader, &template, &template, &key.PublicKey, key)
	if err != nil {
		return nil, err
	}

	keyPEM := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)})
	certPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certDER})

	tlsCert, err := tls.X509KeyPair(certPEM, keyPEM)
	if err != nil {
		return nil, err
	}

	return &tls.Config{
		Certificates: []tls.Certificate{tlsCert},
		NextProtos:   []string{"h3"},
	}, nil
}

// StartServer 启动QUIC服务器
func (p *QUICProxy) StartServer() error {
	if !p.isServer {
		return fmt.Errorf("当前实例不是服务器模式")
	}

	udpAddr, err := net.ResolveUDPAddr("udp", p.localAddr)
	if err != nil {
		return fmt.Errorf("解析UDP地址失败: %w", err)
	}

	udpConn, err := net.ListenUDP("udp", udpAddr)
	if err != nil {
		return fmt.Errorf("监听UDP端口失败: %w", err)
	}

	listener, err := quic.Listen(udpConn, p.tlsConfig, &quic.Config{
		KeepAlivePeriod: 30 * time.Second,
	})
	if err != nil {
		return fmt.Errorf("启动QUIC监听失败: %w", err)
	}

	p.listener = listener
	log.Printf("QUIC服务器启动在: %s", p.localAddr)

	go p.acceptConnections()
	return nil
}

// acceptConnections 接受连接
func (p *QUICProxy) acceptConnections() {
	for p.isRunning {
		conn, err := p.listener.Accept(context.Background())
		if err != nil {
			if p.isRunning {
				log.Printf("接受QUIC连接失败: %v", err)
			}
			continue
		}

		go p.handleConnection(conn)
	}
}

// handleConnection 处理连接
func (p *QUICProxy) handleConnection(conn quic.Connection) {
	defer conn.CloseWithError(0, "")

	remoteAddr := conn.RemoteAddr().String()
	p.mutex.Lock()
	p.connections[remoteAddr] = conn
	p.mutex.Unlock()

	defer func() {
		p.mutex.Lock()
		delete(p.connections, remoteAddr)
		p.mutex.Unlock()
	}()

	log.Printf("新的QUIC连接: %s", remoteAddr)

	for {
		stream, err := conn.AcceptStream(context.Background())
		if err != nil {
			log.Printf("接受流失败: %v", err)
			return
		}

		go p.handleStream(stream)
	}
}

// handleStream 处理流
func (p *QUICProxy) handleStream(stream quic.Stream) {
	defer stream.Close()

	// 读取HTTP请求
	buffer := make([]byte, 4096)
	n, err := stream.Read(buffer)
	if err != nil {
		log.Printf("读取流数据失败: %v", err)
		return
	}

	// 解析HTTP请求（简化版）
	requestData := string(buffer[:n])
	log.Printf("收到HTTP请求: %s", requestData[:min(200, len(requestData))])

	// 代理请求到本地HTTP服务器
	resp, err := http.Post("http://127.0.0.1:8080/proxy", "application/octet-stream",
		io.NopCloser(io.LimitReader(stream, int64(n))))
	if err != nil {
		log.Printf("代理请求失败: %v", err)
		return
	}
	defer resp.Body.Close()

	// 将响应写回流
	io.Copy(stream, resp.Body)
}

// ConnectToPeer 连接到对等节点
func (p *QUICProxy) ConnectToPeer(remoteAddr string) error {
	if p.isServer {
		return fmt.Errorf("服务器模式不能主动连接")
	}

	p.remoteAddr = remoteAddr

	// 创建QUIC连接
	conn, err := quic.DialAddr(context.Background(), remoteAddr, &tls.Config{
		InsecureSkipVerify: true,
		NextProtos:         []string{"h3"},
	}, &quic.Config{
		KeepAlivePeriod: 30 * time.Second,
	})
	if err != nil {
		return fmt.Errorf("连接到QUIC服务器失败: %w", err)
	}

	p.client = conn
	p.mutex.Lock()
	p.connections[remoteAddr] = conn
	p.mutex.Unlock()

	log.Printf("成功连接到QUIC服务器: %s", remoteAddr)
	return nil
}

// ProxyHTTPRequest 代理HTTP请求
func (p *QUICProxy) ProxyHTTPRequest(method, path string, body io.Reader) (*http.Response, error) {
	if p.client == nil {
		return nil, fmt.Errorf("没有活跃的QUIC连接")
	}

	// 创建新的流
	stream, err := p.client.OpenStreamSync(context.Background())
	if err != nil {
		return nil, fmt.Errorf("打开流失败: %w", err)
	}
	defer stream.Close()

	// 构造HTTP请求
	httpReq := fmt.Sprintf("%s %s HTTP/1.1\r\nHost: %s\r\n\r\n", method, path, p.remoteAddr)

	// 发送请求头
	_, err = stream.Write([]byte(httpReq))
	if err != nil {
		return nil, fmt.Errorf("发送请求头失败: %w", err)
	}

	// 发送请求体
	if body != nil {
		_, err = io.Copy(stream, body)
		if err != nil {
			return nil, fmt.Errorf("发送请求体失败: %w", err)
		}
	}

	// 读取响应（简化版）
	response := &http.Response{
		StatusCode: 200,
		Body:       io.NopCloser(stream),
		Header:     make(http.Header),
	}

	return response, nil
}

// GetConnections 获取活跃连接
func (p *QUICProxy) GetConnections() map[string]quic.Connection {
	p.mutex.RLock()
	defer p.mutex.RUnlock()

	connections := make(map[string]quic.Connection)
	for addr, conn := range p.connections {
		connections[addr] = conn
	}
	return connections
}

// Close 关闭代理
func (p *QUICProxy) Close() error {
	p.isRunning = false

	p.mutex.Lock()
	defer p.mutex.Unlock()

	// 关闭所有连接
	for _, conn := range p.connections {
		conn.CloseWithError(0, "服务器关闭")
	}

	// 关闭监听器
	if p.listener != nil {
		p.listener.Close()
	}

	log.Println("QUIC代理已关闭")
	return nil
}

// min 辅助函数
func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}

// 全局QUIC代理实例
var GlobalQUICProxy *QUICProxy

// InitQUICProxy 初始化QUIC代理
func InitQUICProxy(localAddr string, isServer bool) error {
	proxy, err := NewQUICProxy(localAddr, isServer)
	if err != nil {
		return err
	}

	GlobalQUICProxy = proxy

	if isServer {
		return proxy.StartServer()
	}

	return nil
}

// GetGlobalQUICProxy 获取全局QUIC代理实例
func GetGlobalQUICProxy() *QUICProxy {
	return GlobalQUICProxy
}
